import api from "@/lib/api/client";
import type { AxiosRe      // 🔍 EXTRA DEBUG: Verificar si Success es string o boolean
      console.log('🔍 Tipo de Success:', typeof result.Success, '| Valor:', result.Success);
      console.log('🔍 Success === true:', result.Success === true);
      console.log('🔍 Success === "true":', result.Success === "true");
      console.log('🔍 Success (string) lowercase:', typeof result.Success === 'string' ? result.Success.toLowerCase() : 'N/A');
      
      return response.data;e } from "axios";
import { UserMenuResponse, MenuItem, UserInfo } from "@/interface";

// Interfaces para el menú dinámico - ACTUALIZADAS para el sidebar
export interface MenuItem {
  id: string;
  label: string;
  href?: string; // Cambié de 'path' a 'href' para coincidir con sidebar
  iconName?: string; // Cambié de 'icon' a 'iconName' para el mapeo
  items?: MenuItem[]; // Cambié de 'children' a 'items' para coincidir con sidebar
}

export interface UserInfo {
  Name: string; // Simplificado para el sidebar
  Email?: string;
  Roles: string[];
  Groups?: string[]; // Información de grupos desde el backend
}

export interface UserMenuResponse {
  Success: boolean;
  Data: {
    Menu: MenuItem[];
    UserInfo: UserInfo;
  };
  Message: string;
}

export class UserMenuService {
  /**
   * ✅ MEJORES PRÁCTICAS: Solo envía token al backend
   * El backend maneja Microsoft Graph, mapeo de roles y filtrado de menú
   */
  static async getUserMenu(): Promise<UserMenuResponse> {
    try {
      console.log('🔵 Obteniendo menú del usuario desde backend...');

      // ✅ SIMPLE: Solo enviar token JWT al backend
      // El interceptor de Axios automáticamente incluye el token en Authorization header
      const response = await api.get<UserMenuResponse>(
        "http://localhost:7071/api/core/user/menu"
      );

      console.log('✅ Respuesta CRUDA del backend:', response);
      
      // 🔍 DEBUG: Mostrar estructura completa
      console.log('📊 Estructura de response:', {
        data: response.data,
        status: response.status,
        statusText: response.statusText,
        headers: response.headers
      });
      
      const result = response.data as UserMenuResponse;
      console.log('📊 Menú procesado:', result);
      
      // 🔍 EXTRA DEBUG: Verificar si Success es string o boolean
      console.log('� Tipo de Success:', typeof result.Success, '| Valor:', result.Success);
      console.log('🔍 Success === true:', result.Success === true);
      console.log('🔍 Success === "true":', result.Success === "true");
      console.log('🔍 Success (string) lowercase:', typeof result.Success === 'string' ? result.Success.toLowerCase() : 'N/A');      return response.data;

    } catch (error) {
      console.error('❌ Error completo obteniendo menú del usuario:', {
        error,
        message: error instanceof Error ? error.message : 'Error desconocido',
        stack: error instanceof Error ? error.stack : undefined,
        name: error instanceof Error ? error.name : undefined
      });
      
      // ✅ MEJORES PRÁCTICAS: Fallback graceful
      const fallbackResponse: UserMenuResponse = {
        Success: false,
        Data: {
          Menu: [
            {
              id: "dashboard",
              label: "Dashboard",
              href: "/dashboard",
              iconName: "Home"
            }
          ],
          UserInfo: {
            Name: 'Usuario',
            Email: '',
            Roles: ['user'],
            Groups: []
          }
        },
        Message: `Error de conexión: ${error instanceof Error ? error.message : 'Error desconocido'}`
      };

      console.log('🔄 Usando respuesta de fallback:', fallbackResponse);
      return fallbackResponse;
    }
  }

  /**
   * ✅ MEJORES PRÁCTICAS: Refresca el menú forzando nueva consulta al backend
   */
  static async refreshUserMenu(): Promise<UserMenuResponse> {
    try {
      console.log('🔄 Refrescando menú del usuario...');
      
      // Forzar refresh sin cache
      const response = await api.get<UserMenuResponse>(
        "http://localhost:7071/api/core/user/menu",
        {
          headers: {
            'Cache-Control': 'no-cache',
            'X-Force-Refresh': 'true'
          }
        }
      );

      console.log('✅ Menú refrescado desde backend');
      return response.data;

    } catch (error) {
      console.error('❌ Error refrescando menú:', error);
      throw error;
    }
  }
}
